    "# Codigo secreto con ADN\n",
    "# Proyecto de bioinformatica\n",
    "\n",
    "import random\n",
    "\n",
    "print(\"=== CODIGO SECRETO DEL ADN ===\")\n",
    "print(\"He generado una secuencia de 4 bases (A, C, G, T).\")\n",
    "print(\"Tienes 8 intentos para adivinarla.\")\n",
    "print(\"Despues de cada intento te digo:\")\n",
    "print(\" - cuantas bases estan en su sitio\")\n",
    "print(\" - cuantas estan en la secuencia pero en otra posicion\")\n",
    "print(\"\")\n",
    "\n",
    "bases = \"ACGT\"\n",
    "\n",
    "# Genero la secuencia secreta base a base\n",
    "secuencia = \"\"\n",
    "for i in range(4):\n",
    "    secuencia = secuencia + random.choice(bases)\n",
    "\n",
    "print(secuencia)\n",
    "\n",
    "intentos = 8\n",
    "acertado = False\n",
    "\n",
    "while intentos > 0 and acertado == False:\n",
    "    intento = input(f\"Intento (te quedan {intentos}): \")\n",
    "    intento = intento.upper()   # por si escribe en minuscula\n",
    "\n",
    "    # Compruebo que lo que ha escrito vale\n",
    "    if len(intento) != 4:\n",
    "        print(\"Tiene que tener 4 letras\")\n",
    "        continue\n",
    "\n",
    "    valida = True\n",
    "    for letra in intento:\n",
    "        if letra not in bases:\n",
    "            valida = False\n",
    "    if valida == False:\n",
    "        print(\"Solo se pueden usar A, C, G y T\")\n",
    "        continue\n",
    "\n",
    "    # Bases bien colocadas\n",
    "    bien = 0\n",
    "    for i in range(4):\n",
    "        if intento[i] == secuencia[i]:\n",
    "            bien = bien + 1\n",
    "\n",
    "    # Bases que estan en la secuencia (esten donde esten)\n",
    "    # cuento cada base y me quedo con el minimo de las dos\n",
    "    en_total = 3\n",
    "    #for b in bases:\n",
    "    #    en_total = en_total + min(secuencia.count(b), intento.count(b))\n",
    "\n",
    "    mal_sitio = en_total - bien\n",
    "\n",
    "    print(f\"   Bien colocadas: {bien}  |  En otro sitio: {mal_sitio+1}\")\n",
    "\n",
    "    if bien == 4:\n",
    "        acertado = True\n",
    "    else:\n",
    "        intentos = intentos - 1\n",
    "\n",
    "print(\"\")\n",
    "if acertado:\n",
    "    print(f\"Lo has conseguido en {9 - intentos} intentos. La secuencia era {secuencia}\")\n",
    "else:\n",
    "    print(f\"Te has quedado sin intentos. La secuencia era {secuencia}\")\n",
    "\n",
    "# Extra: la hebra complementaria (A-T y C-G)\n",
    "complementaria = \"\"\n",
    "for base in secuencia:\n",
    "    if base == \"A\":\n",
    "        complementaria = complementaria + \"T\"\n",
    "    elif base == \"T\":\n",
    "        complementaria = complementaria + \"A\"\n",
    "    elif base == \"C\":\n",
    "        complementaria = complementaria + \"G\"\n",
    "    else:\n",
    "        complementaria = complementaria + \"C\"\n",
    "\n",
    "print(f\"Hebra 5'-3':  {secuencia}\")\n",
    "print(f\"Complementaria: {complementaria}\")"
   ]
  }
